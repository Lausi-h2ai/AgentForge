# LLM provider
# For a tested local Qwen3.5-9B profile, see examples/local-qwen.env and docs/LOCAL_QWEN.md.
# Install provider-specific extras before enabling one:
#   pip install -e .[openai]
#   pip install -e .[ollama]
#   pip install -e .[google]
LLM_PROVIDER=openai
# Use the exact model ID served by your endpoint.
LLM_MODEL=your-served-model
LLM_ESCALATION_MODEL=
# Chat Completions: llama.cpp, vLLM, or a hosted compatible provider.
# Set the API root, not /chat/completions. Blank key is allowed for auth-free servers.
OPENAI_BASE_URL=http://localhost:8080/v1
OPENAI_API_KEY=
LLM_CONTEXT_WINDOW=32768
LLM_MAX_TOKENS=4096
LLM_REQUEST_TIMEOUT=300
# JSON OpenAI client parameters; use extra_body for server-specific parameters.
OPENAI_ADDITIONAL_KWARGS={}

# Optional vector retrieval. Unset defaults to none for openai, or the legacy provider.
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
OPENAI_EMBEDDING_BASE_URL=
OPENAI_EMBEDDING_API_KEY=

# Only used with the legacy Ollama adapter.
OLLAMA_THINKING=false

# Prompt versions (local prompt files in prompts/<agent>/<version>/)
PROMPT_DEVELOPER_VERSION=v2
PROMPT_REVIEWER_VERSION=v2
PROMPT_REQUIREMENTS_ANALYST_VERSION=v2
PROMPT_SOFTWARE_ARCHITECT_VERSION=v2
PROMPT_PLANNER_VERSION=v2

# Reviewer timeouts (seconds)
REVIEW_TIMEOUT_SIMPLE=60
REVIEW_TIMEOUT_MEDIUM=120
REVIEW_TIMEOUT_COMPLEX=180

# Task-level model escalation (loop fallback)
ESCALATION_ENABLED=false
ESCALATION_AGENTS=developer,reviewer
ESCALATION_REPEAT_THRESHOLD=3
ESCALATION_NO_PROGRESS_THRESHOLD=2

# Planner escalation (planning retries fallback)
PLANNER_ESCALATION_ENABLED=false
PLANNER_ESCALATION_FAILURE_THRESHOLD=1
PLANNER_MAX_ATTEMPTS=2

# HippocampAI (optional local memory)
# Keep disabled unless you also run the local supporting services.
HIPPOCAMP_AI_ENABLED=false
HIPPOCAMP_AI_DEBUG=false
HIPPOCAMP_AI_LLM_PROVIDER=ollama
HIPPOCAMP_AI_LLM_MODEL=gemma3:4b
HIPPOCAMP_AI_OLLAMA_BASE_URL=http://localhost:11434
HIPPOCAMP_AI_VISIBILITY=private
HIPPOCAMP_AI_RUN_ID=
QDRANT_URL=http://localhost:6333


# Google (optional cloud)
GOOGLE_API_KEY=
