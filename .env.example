# LLM provider
LLM_PROVIDER=ollama
LLM_MODEL=gemma3:4b

# Ollama (local)
OLLAMA_PLANNING_MODEL=qwen3-coder-next:cloud
OLLAMA_EXECUTION_MODEL=qwen3-coder-next:cloud
OLLAMA_MODEL=qwen3-coder-next:cloud

# HippocampAI (local memory)
HIPPOCAMP_AI_ENABLED=true
HIPPOCAMP_AI_DEBUG=false
HIPPOCAMP_AI_LLM_PROVIDER=ollama
HIPPOCAMP_AI_LLM_MODEL=gemma3:4b
HIPPOCAMP_AI_OLLAMA_BASE_URL=http://localhost:11434
HIPPOCAMP_AI_VISIBILITY=private
HIPPOCAMP_AI_RUN_ID=
QDRANT_URL=http://localhost:6333


# Google (optional cloud)
GOOGLE_API_KEY=
GOOGLE_PLANNING_MODEL=
GOOGLE_EXECUTION_MODEL=
GOOGLE_MODEL=
