# Copy these settings into .env, or load as process overrides.
# Matches scripts/start_local_qwen.ps1; one slot keeps memory use bounded.
LLM_PROVIDER=openai
LLM_MODEL=qwen3.5-9b-q4_k_m
LLM_ESCALATION_MODEL=
OPENAI_BASE_URL=http://127.0.0.1:8080/v1
OPENAI_API_KEY=
LLM_CONTEXT_WINDOW=16384
LLM_MAX_TOKENS=4096
LLM_REQUEST_TIMEOUT=300
OPENAI_ADDITIONAL_KWARGS={"extra_body":{"chat_template_kwargs":{"enable_thinking":false}}}
EMBEDDING_PROVIDER=none
HIPPOCAMP_AI_ENABLED=false
ESCALATION_ENABLED=false
PLANNER_ESCALATION_ENABLED=false
REVIEW_TIMEOUT_SIMPLE=180
REVIEW_TIMEOUT_MEDIUM=240
REVIEW_TIMEOUT_COMPLEX=300
DEV_NO_TOOL_CALL_TIMEOUT_SECONDS=120
PROMPT_DEVELOPER_VERSION=v2
PROMPT_REVIEWER_VERSION=v2
PROMPT_REQUIREMENTS_ANALYST_VERSION=v2
PROMPT_SOFTWARE_ARCHITECT_VERSION=v2
PROMPT_PLANNER_VERSION=v2
